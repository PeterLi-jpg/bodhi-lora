__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/

data/raw/*.jsonl
!data/raw/high_stakes_prompts.jsonl
# Per-seed eval draws; scripts/make_bootstrap_eval_ids.py rebuilds them from the seed.
data/raw/hard_seed_*.json
data/sft/*.jsonl
data/sft/seed_*/
data/sft/smoke/
data/sft/figures/
# Filtered training traces (49 MB per seed). Regenerable from Stages 1-2.
data/sft_qwen_graded/
eval/smoke/
eval/*.json
eval/seed_*/
eval/figures/

# Model weights, optimizer state and tokenizer copies never go in git.
checkpoints/
*.bin
*.safetensors
optimizer*.pt
results/
# rebuttal/results/ holds small analysis JSON that the paper cites. The
# results/ rule above would hide it, so allow it back in.
!rebuttal/results/

# Rebuttal cells synced from the GPU box. Commit the per-seed summaries and
# eval JSON; keep raw generations and adapter binaries out. Only the adapter
# config and trainer state from each checkpoint are kept.
results_rebuttal/**/*.jsonl
results_rebuttal/**/ckpt/**
!results_rebuttal/**/ckpt/**/
!results_rebuttal/**/ckpt/**/adapter_config.json
!results_rebuttal/**/ckpt/**/trainer_state.json

paper/build/
paper/figures/*.pdf
# Figure 1 is hand-drawn TikZ; its PDF is tracked so the paper builds without a
# second LaTeX run, and make figures rebuilds it byte for byte.
!paper/figures/pipeline.pdf
paper/figures/*.png
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.pdf
paper/*.synctex.gz
paper/missfont.log

logs/
wandb/
*.log

.env
.env.local
.venv/
.venv-*/
env/
.DS_Store
.vscode/
.idea/

temporal/

data/grading/
REBUTTAL_NOTES.md
# Word exports of reviewer replies. The markdown in rebuttal/responses/ is the source.
*.docx

# --- submission build artifacts (regenerable, never commit) ---
*.zip
*.tar.gz
paper/arxiv/
paper/arxiv_upload/
paper/neurips_submission/
paper/preprint/

# --- kept out while the paper is under double-blind review ---
# (these carry real names; re-enable after acceptance)
IRR-clinicians/
paper/AUTHORS.md
CONTRIBUTORS.md

# --- scratch output and local notes ---
outputs/
